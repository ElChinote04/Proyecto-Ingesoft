generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NombreRol {
  ADMINISTRADOR
  DOCENTE
  ALUMNO
  APODERADO
}

enum EstadoBoleta {
  PENDIENTE
  PAGADA
  ANULADA
}

enum EstadoPago {
  INICIADO
  PROCESANDO
  CONFIRMADO
  RECHAZADO
  CANCELADO
}

enum CondicionAsistencia {
  PRESENTE
  TARDANZA
  AUSENTE
}

model Persona {
  apoderado       Apoderado?
  id              Int         @id @default(autoincrement())
  numeroDocumento String      @unique
  nombres         String
  apellidos       String
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())
  modificadoEn    DateTime    @updatedAt
  usuario         Usuario?
  docente         Docente?
  estudiante      Estudiante?
}

model Usuario {
  id                       Int                    @id @default(autoincrement())
  personaId                Int                    @unique
  persona                  Persona                @relation(fields: [personaId], references: [id])
  identificador            String                 @unique
  hashContrasena           String
  activo                   Boolean                @default(true)
  intentosFallidos         Int                    @default(0)
  bloqueadoHasta           DateTime?
  requiereCambioContrasena Boolean                @default(false)
  creadoEn                 DateTime               @default(now())
  modificadoEn             DateTime               @updatedAt
  roles                    UsuarioRol[]
  sesiones                 SesionAuth[]
  eventos                  RegistroAuditoria[]
  asistenciasCreadas       AsistenciaEstudiante[] @relation("Creador")
  asistenciasModificadas   AsistenciaEstudiante[] @relation("Modificador")

  asistenciasDocentesCreadas     AsistenciaDocente[] @relation("CreadorAsistenciaDocente")
  asistenciasDocentesModificadas AsistenciaDocente[] @relation("ModificadorAsistenciaDocente")
  pagosIniciados           Pago[]                 @relation("PagoIniciador")
}

model Instalacion {
  id           Int      @id
  completadaEn DateTime @default(now())
}

model Rol {
  id       Int          @id @default(autoincrement())
  nombre   NombreRol    @unique
  usuarios UsuarioRol[]
}

model UsuarioRol {
  usuarioId Int
  rolId     Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

model SesionAuth {
  id              String   @id
  usuarioId       Int
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ultimaActividad DateTime @default(now())
  expiraEn        DateTime
  creadoEn        DateTime @default(now())

  @@index([expiraEn])
}

model Docente {
  id            Int                   @id @default(autoincrement())
  personaId     Int                   @unique
  persona       Persona               @relation(fields: [personaId], references: [id])
  codigoDocente String                @unique
  asignaciones  CursoSeccionDocente[]

  asistencias AsistenciaDocente[]
}

model Estudiante {
  id               Int                   @id @default(autoincrement())
  personaId        Int                   @unique
  persona          Persona               @relation(fields: [personaId], references: [id])
  codigoEstudiante String                @unique
  apoderados       ApoderadoEstudiante[]
  matriculas       Matricula[]
}

model Apoderado {
  id          Int                   @id @default(autoincrement())
  personaId   Int                   @unique
  persona     Persona               @relation(fields: [personaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudiantes ApoderadoEstudiante[]
}

model ApoderadoEstudiante {
  apoderadoId  Int
  estudianteId Int
  apoderado    Apoderado  @relation(fields: [apoderadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentesco   String     @db.VarChar(50)
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())

  @@id([apoderadoId, estudianteId])
}

model AnioAcademico {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique
  activo      Boolean     @default(false)
  fechaInicio DateTime?   @db.Date
  fechaFin    DateTime?   @db.Date
  secciones   Seccion[]
  matriculas  Matricula[]
}

model Grado {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  secciones Seccion[]
}

model Seccion {
  id              Int                   @id @default(autoincrement())
  nombre          String
  gradoId         Int
  grado           Grado                 @relation(fields: [gradoId], references: [id])
  anioAcademicoId Int
  anioAcademico   AnioAcademico         @relation(fields: [anioAcademicoId], references: [id])
  matriculas      Matricula[]
  asignaciones    CursoSeccionDocente[]

  @@unique([gradoId, anioAcademicoId, nombre])
}

model Matricula {
  id              Int                    @id @default(autoincrement())
  estudianteId    Int
  estudiante      Estudiante             @relation(fields: [estudianteId], references: [id])
  seccionId       Int
  seccion         Seccion                @relation(fields: [seccionId], references: [id])
  anioAcademicoId Int
  anioAcademico   AnioAcademico          @relation(fields: [anioAcademicoId], references: [id])
  activo          Boolean                @default(true)
  creadoEn        DateTime               @default(now())
  modificadoEn    DateTime               @updatedAt
  asistencias     AsistenciaEstudiante[]
  planPago        PlanPago?

  @@unique([estudianteId, anioAcademicoId])
  @@index([seccionId, activo])
}

model Curso {
  id           Int                   @id @default(autoincrement())
  codigo       String                @unique
  nombre       String
  asignaciones CursoSeccionDocente[]
}

model CursoSeccionDocente {
  id        Int                       @id @default(autoincrement())
  cursoId   Int
  curso     Curso                     @relation(fields: [cursoId], references: [id])
  seccionId Int
  seccion   Seccion                   @relation(fields: [seccionId], references: [id])
  docenteId Int
  docente   Docente                   @relation(fields: [docenteId], references: [id])
  bloques   CursoSeccionDocenteAula[]

  @@unique([cursoId, seccionId, docenteId])
}

model Aula {
  id      Int                       @id @default(autoincrement())
  codigo  String                    @unique
  bloques CursoSeccionDocenteAula[]
}

model CursoSeccionDocenteAula {
  activo       Boolean             @default(true)
  id           Int                 @id @default(autoincrement())
  asignacionId Int
  asignacion   CursoSeccionDocente @relation(fields: [asignacionId], references: [id])
  aulaId       Int
  aula         Aula                @relation(fields: [aulaId], references: [id])
  diaSemana    Int
  horaInicio   String
  horaFin      String
  sesiones     SesionClase[]

  // La unicidad solo de bloques activos se aplica mediante índice parcial en SQL.
}

model SesionClase {
  id           Int                     @id @default(autoincrement())
  bloqueId     Int
  bloque       CursoSeccionDocenteAula @relation(fields: [bloqueId], references: [id])
  fecha        DateTime                @db.Date
  horaInicio   String
  horaFin      String
  activo       Boolean                 @default(true)
  creadoEn     DateTime                @default(now())
  modificadoEn DateTime                @updatedAt
  asistencias  AsistenciaEstudiante[]

  @@unique([bloqueId, fecha])
}

model AsistenciaEstudiante {
  id              Int                 @id @default(autoincrement())
  sesionId        Int
  sesion          SesionClase         @relation(fields: [sesionId], references: [id])
  matriculaId     Int
  matricula       Matricula           @relation(fields: [matriculaId], references: [id])
  condicion       CondicionAsistencia
  observacion     String              @default("") @db.VarChar(300)
  creadoEn        DateTime            @default(now())
  modificadoEn    DateTime            @updatedAt
  creadoPorId     Int
  creadoPor       Usuario             @relation("Creador", fields: [creadoPorId], references: [id])
  modificadoPorId Int
  modificadoPor   Usuario             @relation("Modificador", fields: [modificadoPorId], references: [id])

  @@unique([sesionId, matriculaId])
  @@index([matriculaId])
}

/// Cronograma de pensiones pactado al matricular (US-006).
model PlanPago {
  id             Int              @id @default(autoincrement())
  matriculaId    Int              @unique
  matricula      Matricula        @relation(fields: [matriculaId], references: [id])
  montoPension   Decimal          @db.Decimal(10, 2)
  numeroCuotas   Int
  diaVencimiento Int
  mesInicio      Int
  creadoEn       DateTime         @default(now())
  boletas        CompromisoPago[]
}

/// Boleta de pensión emitida a partir del plan (US-006, US-007A).
/// El estado MOROSA no se almacena: se deriva de fechaVencimiento al consultar.
model CompromisoPago {
  id               Int          @id @default(autoincrement())
  planPagoId       Int
  planPago         PlanPago     @relation(fields: [planPagoId], references: [id])
  numeroCuota      Int
  concepto         String       @db.VarChar(120)
  periodo          String       @db.VarChar(7)
  monto            Decimal      @db.Decimal(10, 2)
  fechaVencimiento DateTime     @db.Date
  estado           EstadoBoleta @default(PENDIENTE)
  pagadaEn         DateTime?
  creadoEn         DateTime     @default(now())
  modificadoEn     DateTime     @updatedAt
  pagos            Pago[]

  @@unique([planPagoId, numeroCuota])
  @@index([estado, fechaVencimiento])
}

/// Intento de pago de una boleta a través de la pasarela externa (US-007B).
/// Un índice parcial en SQL garantiza un único pago en curso por boleta.
model Pago {
  id                Int            @id @default(autoincrement())
  compromisoPagoId  Int
  compromisoPago    CompromisoPago @relation(fields: [compromisoPagoId], references: [id])
  referencia        String         @unique @db.VarChar(64)
  referenciaExterna String?        @unique @db.VarChar(255)
  monto             Decimal        @db.Decimal(10, 2)
  estado            EstadoPago     @default(INICIADO)
  proveedor         String         @db.VarChar(40)
  motivoRechazo     String?        @db.VarChar(200)
  confirmadoEn      DateTime?
  iniciadoPorId     Int
  iniciadoPor       Usuario        @relation("PagoIniciador", fields: [iniciadoPorId], references: [id])
  creadoEn          DateTime       @default(now())
  modificadoEn      DateTime       @updatedAt

  @@index([compromisoPagoId, estado])
}

model RegistroAuditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fechaHora  DateTime @default(now())
  tipoEvento String
  entidad    String   @default("Registro")
  resultado  String   @default("EXITO")
  requestId  String?
  entidadId  Int
  detalle    Json

  @@index([entidadId, fechaHora])
  @@index([tipoEvento, fechaHora], map: "RegistroAuditoria_tipo_fecha")
}

model AsistenciaDocente {
  id        Int     @id @default(autoincrement())
  docenteId Int
  docente   Docente @relation(fields: [docenteId], references: [id])

  fecha       DateTime            @db.Date
  condicion   CondicionAsistencia
  observacion String              @default("") @db.VarChar(300)

  creadoEn     DateTime @default(now())
  modificadoEn DateTime @updatedAt

  creadoPorId Int
  creadoPor   Usuario @relation("CreadorAsistenciaDocente", fields: [creadoPorId], references: [id])

  modificadoPorId Int
  modificadoPor   Usuario @relation("ModificadorAsistenciaDocente", fields: [modificadoPorId], references: [id])

  @@unique([docenteId, fecha])
  @@index([fecha])
}
