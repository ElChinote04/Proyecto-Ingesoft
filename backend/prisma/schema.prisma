generator client {
  provider = "prisma-client-js"
}

enum NivelLogro {
  AD
  A
  B
  C
}

enum EstadoEvidenciaPedagogica {
  PENDIENTE_REVISION
  OBSERVADA
  VALIDADA
}

datasource db {
  provider = "postgresql"
}

model BimestreAcademico {
  id              Int                  @id @default(autoincrement())
  anioAcademicoId Int
  anioAcademico   AnioAcademico        @relation(fields: [anioAcademicoId], references: [id])
  numero          Int
  nombre          String
  fechaInicio     DateTime?            @db.Date
  fechaFin        DateTime?            @db.Date
  activo          Boolean              @default(true)
  calificaciones  Calificacion[]
  planes          PlanAcademico[]
  publicaciones   PublicacionSeccion[]

  @@unique([anioAcademicoId, numero])
}

model Competencia {
  id             Int                       @id @default(autoincrement())
  cursoId        Int
  curso          Curso                     @relation(fields: [cursoId], references: [id])
  codigo         String                    @unique
  nombre         String
  descripcion    String
  activo         Boolean                   @default(true)
  calificaciones CalificacionCompetencia[]
  planes         PlanAcademico[]
}

model Calificacion {
  id              Int                       @id @default(autoincrement())
  matriculaId     Int
  matricula       Matricula                 @relation(fields: [matriculaId], references: [id])
  bimestreId      Int
  bimestre        BimestreAcademico         @relation(fields: [bimestreId], references: [id])
  asignacionId    Int
  asignacion      CursoSeccionDocente       @relation(fields: [asignacionId], references: [id])
  reglaId         Int
  regla           ReglaConsolidacion        @relation(fields: [reglaId], references: [id])
  activo          Boolean                   @default(true)
  creadoPorId     Int
  modificadoPorId Int
  competencias    CalificacionCompetencia[]
  creadoEn        DateTime                  @default(now())
  modificadoEn    DateTime                  @updatedAt

  @@unique([matriculaId, bimestreId, asignacionId])
}

model CalificacionCompetencia {
  id                    Int                     @id @default(autoincrement())
  calificacionId        Int
  calificacion          Calificacion            @relation(fields: [calificacionId], references: [id])
  competenciaId         Int
  competencia           Competencia             @relation(fields: [competenciaId], references: [id])
  nivelLogro            NivelLogro
  conclusionDescriptiva String?
  activo                Boolean                 @default(true)
  creadoPorId           Int
  modificadoPorId       Int
  creadoEn              DateTime                @default(now())
  modificadoEn          DateTime                @updatedAt
  evidencias            EvidenciaCalificacion[]

  @@unique([calificacionId, competenciaId])
}

model EvidenciaCalificacion {
  id                        Int                            @id @default(autoincrement())
  calificacionCompetenciaId Int
  calificacionCompetencia   CalificacionCompetencia        @relation(fields: [calificacionCompetenciaId], references: [id])
  titulo                    String
  descripcion               String?
  nivelLogroRegistrado      NivelLogro
  activo                    Boolean                        @default(true)
  creadoPorId               Int
  modificadoPorId           Int
  creadoEn                  DateTime                       @default(now())
  modificadoEn              DateTime                       @updatedAt
  archivos                  ArchivoEvidenciaCalificacion[]

  @@index([calificacionCompetenciaId, activo])
}

model ArchivoEvidenciaCalificacion {
  id               Int                   @id @default(autoincrement())
  evidenciaId      Int
  evidencia        EvidenciaCalificacion @relation(fields: [evidenciaId], references: [id])
  nombreOriginal   String
  nombreAlmacenado String                @unique
  tipoMime         String
  tamanoBytes      Int
  activo           Boolean               @default(true)
  creadoPorId      Int
  creadoEn         DateTime              @default(now())

  @@index([evidenciaId, activo])
}

model PublicacionSeccion {
  id             Int               @id @default(autoincrement())
  bimestreId     Int
  bimestre       BimestreAcademico @relation(fields: [bimestreId], references: [id])
  seccionId      Int
  seccion        Seccion           @relation(fields: [seccionId], references: [id])
  publicadoPorId Int
  publicadoEn    DateTime          @default(now())

  @@unique([bimestreId, seccionId])
}

enum NombreRol {
  ADMINISTRADOR
  DOCENTE
  ALUMNO
  APODERADO
}

enum EstadoBoleta {
  PENDIENTE
  /// US-010: boleta fraccionada en cuotas cuyo total todavía no se completa.
  PARCIAL
  PAGADA
  ANULADA
}

enum EstadoPago {
  INICIADO
  PROCESANDO
  CONFIRMADO
  RECHAZADO
  CANCELADO
  ANULADO
}

enum CondicionAsistencia {
  PRESENTE
  TARDANZA
  AUSENTE
}

model Persona {
  apoderado       Apoderado?
  id              Int         @id @default(autoincrement())
  numeroDocumento String      @unique
  nombres         String
  apellidos       String
  activo          Boolean     @default(true)
  creadoEn        DateTime    @default(now())
  modificadoEn    DateTime    @updatedAt
  usuario         Usuario?
  docente         Docente?
  estudiante      Estudiante?
}

model Usuario {
  id                       Int                    @id @default(autoincrement())
  personaId                Int                    @unique
  persona                  Persona                @relation(fields: [personaId], references: [id])
  identificador            String                 @unique
  hashContrasena           String
  activo                   Boolean                @default(true)
  intentosFallidos         Int                    @default(0)
  bloqueadoHasta           DateTime?
  requiereCambioContrasena Boolean                @default(false)
  creadoEn                 DateTime               @default(now())
  modificadoEn             DateTime               @updatedAt
  roles                    UsuarioRol[]
  sesiones                 SesionAuth[]
  eventos                  RegistroAuditoria[]
  asistenciasCreadas       AsistenciaEstudiante[] @relation("Creador")
  asistenciasModificadas   AsistenciaEstudiante[] @relation("Modificador")
  reglasCreadas            ReglaConsolidacion[]   @relation("ReglaCreador")
  reglasModificadas        ReglaConsolidacion[]   @relation("ReglaModificador")

  asistenciasDocentesCreadas     AsistenciaDocente[]   @relation("CreadorAsistenciaDocente")
  asistenciasDocentesModificadas AsistenciaDocente[]   @relation("ModificadorAsistenciaDocente")
  pagosIniciados                 Pago[]                @relation("PagoIniciador")
  evidenciasRevisadas            EvidenciaPedagogica[] @relation("EvidenciaRevisor")
  asistenciasDocentesCreadas     AsistenciaDocente[] @relation("CreadorAsistenciaDocente")
  asistenciasDocentesModificadas AsistenciaDocente[] @relation("ModificadorAsistenciaDocente")
  pagosIniciados                 Pago[]              @relation("PagoIniciador")
  pagosAnulados                  Pago[]              @relation("PagoAnulador")
}

model Instalacion {
  id           Int      @id
  completadaEn DateTime @default(now())
}

model Rol {
  id       Int          @id @default(autoincrement())
  nombre   NombreRol    @unique
  usuarios UsuarioRol[]
}

model UsuarioRol {
  usuarioId Int
  rolId     Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
}

model SesionAuth {
  id              String   @id
  usuarioId       Int
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ultimaActividad DateTime @default(now())
  expiraEn        DateTime
  creadoEn        DateTime @default(now())

  @@index([expiraEn])
}

model Docente {
  id            Int                   @id @default(autoincrement())
  personaId     Int                   @unique
  persona       Persona               @relation(fields: [personaId], references: [id])
  codigoDocente String                @unique
  activo        Boolean               @default(true)
  asignaciones  CursoSeccionDocente[]
  evidencias    EvidenciaPedagogica[]

  asistencias AsistenciaDocente[]
}

model Estudiante {
  id               Int                   @id @default(autoincrement())
  personaId        Int                   @unique
  persona          Persona               @relation(fields: [personaId], references: [id])
  codigoEstudiante String                @unique
  apoderados       ApoderadoEstudiante[]
  matriculas       Matricula[]
}

model Apoderado {
  id          Int                   @id @default(autoincrement())
  personaId   Int                   @unique
  persona     Persona               @relation(fields: [personaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudiantes ApoderadoEstudiante[]
}

model ApoderadoEstudiante {
  apoderadoId  Int
  estudianteId Int
  apoderado    Apoderado  @relation(fields: [apoderadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentesco   String     @db.VarChar(50)
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())

  @@id([apoderadoId, estudianteId])
}

model AnioAcademico {
  id          Int                 @id @default(autoincrement())
  codigo      String              @unique
  activo      Boolean             @default(false)
  fechaInicio DateTime?           @db.Date
  fechaFin    DateTime?           @db.Date
  secciones   Seccion[]
  matriculas  Matricula[]
  bimestres   BimestreAcademico[]
}

model Grado {
  id        Int                  @id @default(autoincrement())
  nombre    String               @unique
  secciones Seccion[]
  reglas    ReglaConsolidacion[]
}

model Seccion {
  id              Int                   @id @default(autoincrement())
  nombre          String
  gradoId         Int
  grado           Grado                 @relation(fields: [gradoId], references: [id])
  anioAcademicoId Int
  anioAcademico   AnioAcademico         @relation(fields: [anioAcademicoId], references: [id])
  matriculas      Matricula[]
  asignaciones    CursoSeccionDocente[]
  publicaciones   PublicacionSeccion[]

  @@unique([gradoId, anioAcademicoId, nombre])
}

model Matricula {
  id              Int                    @id @default(autoincrement())
  estudianteId    Int
  estudiante      Estudiante             @relation(fields: [estudianteId], references: [id])
  seccionId       Int
  seccion         Seccion                @relation(fields: [seccionId], references: [id])
  anioAcademicoId Int
  anioAcademico   AnioAcademico          @relation(fields: [anioAcademicoId], references: [id])
  activo          Boolean                @default(true)
  creadoEn        DateTime               @default(now())
  modificadoEn    DateTime               @updatedAt
  asistencias     AsistenciaEstudiante[]
  calificaciones  Calificacion[]
  planPago        PlanPago?

  @@unique([estudianteId, anioAcademicoId])
  @@index([seccionId, activo])
}

model Curso {
  id              Int                   @id @default(autoincrement())
  codigo          String                @unique
  nombre          String
  descripcion     String?
  activo          Boolean               @default(true)
  creadoPorId     Int?
  modificadoPorId Int?
  asignaciones    CursoSeccionDocente[]
  reglas          ReglaConsolidacion[]
  competencias    Competencia[]
}

model CursoSeccionDocente {
  id             Int                       @id @default(autoincrement())
  cursoId        Int
  curso          Curso                     @relation(fields: [cursoId], references: [id])
  seccionId      Int
  seccion        Seccion                   @relation(fields: [seccionId], references: [id])
  docenteId      Int
  docente        Docente                   @relation(fields: [docenteId], references: [id])
  activo         Boolean                   @default(true)
  bloques        CursoSeccionDocenteAula[]
  calificaciones Calificacion[]
  planes         PlanAcademico[]

  @@unique([cursoId, seccionId, docenteId])
}

model Aula {
  id      Int                       @id @default(autoincrement())
  codigo  String                    @unique
  bloques CursoSeccionDocenteAula[]
}

model CursoSeccionDocenteAula {
  activo       Boolean             @default(true)
  id           Int                 @id @default(autoincrement())
  asignacionId Int
  asignacion   CursoSeccionDocente @relation(fields: [asignacionId], references: [id])
  aulaId       Int
  aula         Aula                @relation(fields: [aulaId], references: [id])
  diaSemana    Int
  horaInicio   String
  horaFin      String
  sesiones     SesionClase[]

  // La unicidad solo de bloques activos se aplica mediante índice parcial en SQL.
}

model SesionClase {
  id           Int                     @id @default(autoincrement())
  bloqueId     Int
  bloque       CursoSeccionDocenteAula @relation(fields: [bloqueId], references: [id])
  fecha        DateTime                @db.Date
  horaInicio   String
  horaFin      String
  activo       Boolean                 @default(true)
  creadoEn     DateTime                @default(now())
  modificadoEn DateTime                @updatedAt
  asistencias  AsistenciaEstudiante[]

  @@unique([bloqueId, fecha])
}

model AsistenciaEstudiante {
  id              Int                 @id @default(autoincrement())
  sesionId        Int
  sesion          SesionClase         @relation(fields: [sesionId], references: [id])
  matriculaId     Int
  matricula       Matricula           @relation(fields: [matriculaId], references: [id])
  condicion       CondicionAsistencia
  observacion     String              @default("") @db.VarChar(300)
  creadoEn        DateTime            @default(now())
  modificadoEn    DateTime            @updatedAt
  creadoPorId     Int
  creadoPor       Usuario             @relation("Creador", fields: [creadoPorId], references: [id])
  modificadoPorId Int
  modificadoPor   Usuario             @relation("Modificador", fields: [modificadoPorId], references: [id])

  @@unique([sesionId, matriculaId])
  @@index([matriculaId])
}

/// Cronograma de pensiones pactado al matricular (US-006).
model PlanPago {
  id             Int              @id @default(autoincrement())
  matriculaId    Int              @unique
  matricula      Matricula        @relation(fields: [matriculaId], references: [id])
  montoPension   Decimal          @db.Decimal(10, 2)
  numeroCuotas   Int
  diaVencimiento Int
  mesInicio      Int
  creadoEn       DateTime         @default(now())
  boletas        CompromisoPago[]
}

/// Boleta de pensión emitida a partir del plan (US-006, US-007A).
/// El estado MOROSA no se almacena: se deriva de fechaVencimiento al consultar.
model CompromisoPago {
  id               Int              @id @default(autoincrement())
  planPagoId       Int
  planPago         PlanPago         @relation(fields: [planPagoId], references: [id])
  numeroCuota      Int
  concepto         String           @db.VarChar(120)
  periodo          String           @db.VarChar(7)
  monto            Decimal          @db.Decimal(10, 2)
  fechaVencimiento DateTime         @db.Date
  estado           EstadoBoleta     @default(PENDIENTE)
  pagadaEn         DateTime?
  creadoEn         DateTime         @default(now())
  modificadoEn     DateTime         @updatedAt
  pagos            Pago[]
  /// Uno vigente como máximo (índice parcial en SQL); los anulados se conservan (US-013).
  comprobantes     Comprobante[]
  /// US-010: una boleta fraccionada se reemplaza, para el cobro, por sus
  /// fracciones; cada fracción es una boleta que se paga y se comprueba sola.
  boletaOrigenId   Int?
  boletaOrigen     CompromisoPago?  @relation("Fraccionamiento", fields: [boletaOrigenId], references: [id])
  fracciones       CompromisoPago[] @relation("Fraccionamiento")
  /// 0 en la boleta original; 1..N en cada fracción.
  numeroFraccion   Int              @default(0)

  @@unique([planPagoId, numeroCuota, numeroFraccion])
  @@index([boletaOrigenId])
  @@index([estado, fechaVencimiento])
}

/// Intento de pago de una boleta a través de la pasarela externa (US-007B).
/// Un índice parcial en SQL garantiza un único pago en curso por boleta.
model Pago {
  id                Int            @id @default(autoincrement())
  compromisoPagoId  Int
  compromisoPago    CompromisoPago @relation(fields: [compromisoPagoId], references: [id])
  referencia        String         @unique @db.VarChar(64)
  referenciaExterna String?        @unique @db.VarChar(255)
  monto             Decimal        @db.Decimal(10, 2)
  estado            EstadoPago     @default(INICIADO)
  proveedor         String         @db.VarChar(40)
  motivoRechazo     String?        @db.VarChar(200)
  confirmadoEn      DateTime?
  iniciadoPorId     Int
  iniciadoPor       Usuario        @relation("PagoIniciador", fields: [iniciadoPorId], references: [id])
  /// US-013: anulación por el administrador. El pago no se borra: queda ANULADO.
  anuladoEn         DateTime?
  anuladoPorId      Int?
  anuladoPor        Usuario?       @relation("PagoAnulador", fields: [anuladoPorId], references: [id])
  motivoAnulacion   String?        @db.VarChar(300)
  creadoEn          DateTime       @default(now())
  modificadoEn      DateTime       @updatedAt
  comprobante       Comprobante?

  @@index([compromisoPagoId, estado])
}

/// Comprobante de pago de una boleta (US-009). Se emite en la misma transacción
/// que confirma el pago, de modo que toda boleta PAGADA tiene exactamente uno
/// vigente. Si el pago se anula (US-013) el comprobante queda anulado y la boleta
/// puede volver a pagarse con uno nuevo; un índice parcial en SQL impide dos
/// comprobantes vigentes para la misma boleta.
/// El id es el correlativo: se muestra como B001-00000001.
model Comprobante {
  id               Int            @id @default(autoincrement())
  serie            String         @default("B001") @db.VarChar(4)
  pagoId           Int            @unique
  pago             Pago           @relation(fields: [pagoId], references: [id])
  compromisoPagoId Int
  compromisoPago   CompromisoPago @relation(fields: [compromisoPagoId], references: [id])
  emitidoEn        DateTime       @default(now())
  anuladoEn        DateTime?

  @@index([compromisoPagoId])
}

model ReglaConsolidacion {
  id              Int            @id @default(autoincrement())
  gradoId         Int
  grado           Grado          @relation(fields: [gradoId], references: [id])
  cursoId         Int
  curso           Curso          @relation(fields: [cursoId], references: [id])
  nombre          String
  version         Int
  metodo          String
  vigenteDesde    DateTime       @default(now())
  vigenteHasta    DateTime?
  activo          Boolean        @default(true)
  creadoPorId     Int
  creadoPor       Usuario        @relation("ReglaCreador", fields: [creadoPorId], references: [id])
  modificadoPorId Int
  modificadoPor   Usuario        @relation("ReglaModificador", fields: [modificadoPorId], references: [id])
  creadoEn        DateTime       @default(now())
  modificadoEn    DateTime       @updatedAt
  calificaciones  Calificacion[]

  @@unique([gradoId, cursoId, version])
  @@index([gradoId, cursoId, activo])
}

model PlanAcademico {
  id              Int                   @id @default(autoincrement())
  bimestreId      Int
  bimestre        BimestreAcademico     @relation(fields: [bimestreId], references: [id])
  asignacionId    Int
  asignacion      CursoSeccionDocente   @relation(fields: [asignacionId], references: [id])
  titulo          String
  objetivo        String
  fechaInicio     DateTime              @db.Date
  fechaFin        DateTime?             @db.Date
  activo          Boolean               @default(true)
  creadoPorId     Int
  modificadoPorId Int
  creadoEn        DateTime              @default(now())
  modificadoEn    DateTime              @updatedAt
  competencias    Competencia[]
  evidencias      EvidenciaPedagogica[]

  @@index([asignacionId, activo])
}

model EvidenciaPedagogica {
  id                    Int                       @id @default(autoincrement())
  docenteId             Int
  docente               Docente                   @relation(fields: [docenteId], references: [id])
  planId                Int
  plan                  PlanAcademico             @relation(fields: [planId], references: [id])
  revisorId             Int?
  revisor               Usuario?                  @relation("EvidenciaRevisor", fields: [revisorId], references: [id])
  fechaRegistro         DateTime                  @db.Date
  fechaEntrega          DateTime?                 @db.Date
  descripcionAvance     String
  archivos              String[]
  observacionesRevision String?
  estadoRevision        EstadoEvidenciaPedagogica @default(PENDIENTE_REVISION)
  fechaRevision         DateTime?                 @db.Date
  activo                Boolean                   @default(true)
  creadoPorId           Int
  modificadoPorId       Int
  creadoEn              DateTime                  @default(now())
  modificadoEn          DateTime                  @updatedAt

  @@index([planId, activo])
}

model RegistroAuditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fechaHora  DateTime @default(now())
  tipoEvento String
  entidad    String   @default("Registro")
  resultado  String   @default("EXITO")
  requestId  String?
  entidadId  Int
  detalle    Json

  @@index([entidadId, fechaHora])
  @@index([tipoEvento, fechaHora], map: "RegistroAuditoria_tipo_fecha")
}

model AsistenciaDocente {
  id        Int     @id @default(autoincrement())
  docenteId Int
  docente   Docente @relation(fields: [docenteId], references: [id])

  fecha       DateTime            @db.Date
  condicion   CondicionAsistencia
  observacion String              @default("") @db.VarChar(300)

  creadoEn     DateTime @default(now())
  modificadoEn DateTime @updatedAt

  creadoPorId Int
  creadoPor   Usuario @relation("CreadorAsistenciaDocente", fields: [creadoPorId], references: [id])

  modificadoPorId Int
  modificadoPor   Usuario @relation("ModificadorAsistenciaDocente", fields: [modificadoPorId], references: [id])

  @@unique([docenteId, fecha])
  @@index([fecha])
}
