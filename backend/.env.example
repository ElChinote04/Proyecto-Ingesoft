NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://sage:sage_password@localhost:5432/sage
TEST_DATABASE_URL=postgresql://sage:sage_password@localhost:5432/sage_test
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_in_real_environments
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
LOG_DIR=logs
DEMO_PASSWORD=Docente123!
# Solo se exige para el alta inicial protegida (producción, modo test o acceso por red).
# El desarrollo local en loopback crea el primer administrador sin pedir esta clave.
INITIAL_SETUP_KEY=generate_on_setup

# Seguridad de acceso: 5 intentos, 15 minutos de bloqueo y 30 minutos de inactividad.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
SESSION_IDLE_SECONDS=1800

# Carpeta de los archivos de evidencia pedagógica (US-019), relativa a backend/. No se sirve de
# forma pública y no entra en un respaldo de PostgreSQL: hay que respaldarla aparte.
EVIDENCIAS_DIR=storage/evidencias

# Encabezado de la libreta de notas (US-020). Sin valor, la celda del documento queda en blanco.
INSTITUCION_NOMBRE=
INSTITUCION_DRE=
INSTITUCION_UGEL=
INSTITUCION_CODIGO_MODULAR=
INSTITUCION_NIVEL=

# Pasarela de pagos (US-007B, ADR-002 del Documento de Arquitectura).
# 'simulada' permite desarrollar y correr las pruebas sin credenciales ni red.
# 'stripe' usa Stripe Checkout en modo de prueba: crea la cuenta, copia la
# llave secreta de prueba y, para el webhook, instala la CLI de Stripe y ejecuta
# "stripe login" una vez. npm run dev (y Start-Sage.ps1) levanta solo
#   stripe listen --forward-to localhost:3000/api/v1/pagos/notificaciones
# cuando PAGOS_PROVEEDOR=stripe (SAGE_STRIPE_LISTEN=0 lo desactiva). El secreto
# de firma, que va en STRIPE_WEBHOOK_SECRET, se obtiene con: stripe listen --print-secret
PAGOS_PROVEEDOR=simulada
PAGOS_MONEDA=PEN
PAGOS_TIMEOUT_MS=10000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=secreto_de_pruebas_simulada

# US-011: días de anticipación con que el portal avisa al apoderado que una
# pensión está por vencer (entre 1 y 30).
PAGOS_DIAS_AVISO=5
