NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://sage:sage_password@localhost:5432/sage
TEST_DATABASE_URL=postgresql://sage:sage_password@localhost:5432/sage_test
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_in_real_environments
JWT_EXPIRES_IN=1h
LOG_LEVEL=info
LOG_DIR=logs
DEMO_PASSWORD=Docente123!
# Solo se exige para el alta inicial protegida (producción, modo test o acceso por red).
# El desarrollo local en loopback crea el primer administrador sin pedir esta clave.
INITIAL_SETUP_KEY=generate_on_setup

# Seguridad de acceso: 5 intentos, 15 minutos de bloqueo y 30 minutos de inactividad.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
SESSION_IDLE_SECONDS=1800
