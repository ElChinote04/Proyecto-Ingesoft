# Variables del despliegue en servidor (docker-compose.prod.yml).
# Copia este archivo a deploy/.env en el servidor; deploy/.env no se versiona.
# Guía completa: docs/DESPLIEGUE_AWS.md.

# Dominio público. Sin dominio propio sirve <ip-con-guiones>.sslip.io,
# por ejemplo 3-90-12-34.sslip.io para la IP 3.90.12.34.
SAGE_DOMINIO=

# Genera cada secreto con:
#   openssl rand -hex 32
# Solo letras y números: la contraseña de la base va dentro de una URL.
POSTGRES_PASSWORD=
JWT_SECRET=
INITIAL_SETUP_KEY=

# Stripe en modo de prueba. En producción SAGE no admite la pasarela simulada.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
